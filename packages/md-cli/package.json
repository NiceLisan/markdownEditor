{
  "name": "@doocs/md-cli",
  "version": "2.1.3",
  "type": "commonjs",
  "description": "WeChat Markdown Editor | 一款高度简洁的微信 Markdown 编辑器：支持 Markdown 语法、自定义主题样式、内容管理、多图床、AI 助手等特性",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "tsx watch index.js",
    "build:exe": "pkg . --compress Brotli --options max-old-space-size=4096",
    "build:exe:win": "pkg . --targets node18-win-x64 --compress Brotli --options max-old-space-size=4096",
    "build:exe:all": "pkg . --targets node18-win-x64,node18-macos-x64,node18-linux-x64 --compress Brotli --options max-old-space-size=4096"
  },
  "bin": {
    "md-cli": "index.cjs"
  },
  "pkg": {
    "assets": [
      "dist/**/*",
      "public/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "build",
    "compress": "Brotli"
  },
  "files": [
    "dist",
    "public",
    "index.js",
    "server.js",
    "util.js",
    "renderer.js"
  ],
  "keywords": [
    "markdown",
    "editor",
    "wechat",
    "windows",
    "cli"
  ],
  "author": "yanglbme",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/doocs/md"
  },
  "bugs": {
    "url": "https://github.com/doocs/md/issues"
  },
  "dependencies": {
    "es-toolkit": "^1.44.0",
    "express": "^5.2.1",
    "fflate": "^0.8.2",
    "form-data": "4.0.5",
    "front-matter": "^4.0.2",
    "get-port": "7.1.0",
    "highlight.js": "^11.9.0",
    "http-proxy-middleware": "^3.0.5",
    "isomorphic-dompurify": "^2.35.0",
    "juice": "^11.0.3",
    "katex": "^0.16.21",
    "marked": "^17.0.1",
    "mermaid": "^11.12.2",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "postcss": "^8.5.3",
    "postcss-calc": "^10.1.1",
    "postcss-custom-properties": "^14.0.4",
    "reading-time": "^1.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.11",
    "pkg": "catalog:"
  }
}